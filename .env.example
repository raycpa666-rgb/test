# Copy to .env and fill in, or export these in your shell / CI secrets.

# --- Claude (relevance assessment + summaries) ---
# Without this the agent still runs, but falls back to keyword scoring
# and template summaries.
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5

# --- Email delivery (only needed for --send) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SSL=false               # true to use port 465 / implicit TLS instead of STARTTLS
SMTP_USER=you@gmail.com
# Gmail requires an App Password (Google Account > Security > App passwords),
# not your normal account password.
SMTP_PASSWORD=your-app-password
EMAIL_FROM=you@gmail.com
EMAIL_TO=you@gmail.com       # comma-separated for multiple recipients
